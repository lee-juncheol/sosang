{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled UI in the main window: core APIs, the camera commands, card settings files, photo sending, saving files, opening https links and app updates. Remote pages get nothing because no `remote` URLs are listed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-camera-status",
    "allow-camera-list-luts",
    "allow-camera-register-lut",
    "allow-camera-register-luts",
    "allow-camera-delete-luts",
    "allow-camera-rearrange-luts",
    "allow-camera-list-backups",
    "allow-camera-restore-backup",
    "allow-card-find-settings",
    "allow-card-list-luts",
    "allow-card-register-luts",
    "allow-courier-pick-folder",
    "allow-courier-list",
    "allow-courier-list-saved",
    "allow-courier-thumbnail",
    "allow-courier-preview",
    "allow-courier-export",
    "allow-save-file",
    "allow-open-external",
    "allow-app-check-update",
    "allow-app-install-update"
  ]
}

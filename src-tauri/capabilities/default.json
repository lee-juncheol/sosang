{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled UI in the main window: core APIs, the camera commands, saving files and opening https links. Remote pages get nothing because no `remote` URLs are listed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-camera-status",
    "allow-camera-list-luts",
    "allow-camera-register-lut",
    "allow-camera-register-luts",
    "allow-camera-delete-luts",
    "allow-camera-list-backups",
    "allow-camera-restore-backup",
    "allow-save-file",
    "allow-open-external"
  ]
}

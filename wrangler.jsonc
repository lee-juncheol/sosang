{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sosang",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/locale", "/api/contact", "/app/latest.json"],
    "not_found_handling": "none"
  },
  "kv_namespaces": [{ "binding": "CONTACT" }],
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
